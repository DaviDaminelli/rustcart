# Escolha UM banco — o esquema da URL decide qual driver o Diesel usa.
DATABASE_URL=sqlite://rustcart.db
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/rustcart

BIND_ADDR=127.0.0.1:8080
# Origens liberadas no CORS (Rocket e Vite dev), separadas por vírgula
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
RUST_LOG=info,actix_web=info
